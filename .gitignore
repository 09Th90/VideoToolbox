# @version 1.12.2
# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Virtual environments (regenerable)
.buildvenv/
.venv/
venv/

# Sensitive: API keys and browser profile with cookies
data/ai_config.json
data/uploader_profile/
# 本机 GitHub 代理配置（含代理节点 UUID/密码/secret，严禁入库）
github_proxy.yaml

# 运行期日志（VideoCaptioner 唤起日志；配置与模型在 %LOCALAPPDATA%\VideoCaptioner）
data/videocaptioner/

# Runtimes / large binaries (available via GitHub Releases)
# 注：v1.10.0 起字幕改用内置 VideoCaptioner，tools/asr_model 已废弃不再需要
tools/python/
tools/ms-playwright/
tools/ffmpeg.exe
tools/ffprobe.exe
tools/yt-dlp.exe
tools/deno.exe
tools/mihomo/

# Over-limit artifacts (>100MB, available via GitHub Releases)
installer/*.exe
build/archives/

# 运行期用户数据（缩略图缓存、自检产物、配置备份）
data/thumb_cache/
data/*.selftest_bak
data/GUI_SELFTEST_REPORT.txt
data/GUI_SELFTEST_OK

# v1.10.6 数据根目录机制：运行期临时目录与数据目录指针文件
# 注：data_dir.txt 记录用户自定义的数据根路径，属本机设置不入库
data/tmp/
data/videocaptioner/
data/VideoCaptioner/
data/downloads/
data_dir.txt
# 运行期本机配置 / 投稿任务 / 目录缓存 / 校准同步基线快照（均自动生成，不入库）
data/config.json
data/uploader_tasks/
data/catalog/
data/calib_sync_base.py
data/calib_sync_kb_base.json
# 校准知识同步的本机状态与探测产物（v1.12.0 补：曾误入库 data/_kb_probe.json）
data/calib_sync/
data/calib_sync_remote/
data/_kb_probe.json
# 字幕校准学习库（v1.12.1）：程序运行期会持续改写它，导致 git 常驻「已修改」状态；
# 遂改为不入库，仓库内保留的初始副本见 history/ 留档。
subtitle_learned_kb.json

# 运行期日志（校准脚本 GitHub 同步日志、投稿运行日志）
logs/
logs/calib_sync.log
logs/uploader/

# 构建残留（编译日志、界面截图、版本备份、旧 exe）
build/compile_*.log
build/*.png
build/backup_*/
build/legacy/
build/ai_test/
# 校准功能本地自测样例（临时文件，不入库）
build/test_calib*

# 历史归档：仅 history/ 下分类后的源码快照、开发脚本、发布留档、文档入库；
# 以下大体积/日志/截图类留档只保留在本机，不进 git（dist/、_installer_check/
# 已由对应通用规则覆盖）
history/build/
history/logs/
history/data/

# 打包中间产物 / 超限二进制：走 GitHub Releases 或在线仓库分发，不进 git
dist/
build/视频工具箱/
build/ifw_config/
build/ifw_packages/
# 构建兜底暂存：中文路径下 rmtree 被安全删除钩子拦下时，staging 目录整体移到这里
build/ifw_trash/
installer_repository/
# PyInstaller 工作目录（v1.12.0 起用 ASCII 路径 build_ascii 跑打包，避免中文路径
# 让 Qt 钩子读成 ?????；133MB 级中间产物，永不入库）
build_ascii/
# 旧 exe 留档（每次重打包会挪一份进来，体积大）
history/old_builds/

# 临时诊断脚本 / 构建日志 / 截图（本地用，不入库）
_probe_big.py
aqtinstall.log
build_*.log
upgrade_test*.log
src/_diag_embed*.py
src/_diag_out.txt
_installer_check/
.workbuddy/
tools/videocaptioner/
tools/asr_model/

# 管理员工具产物与打包工作目录（kb_admin 独立程序：源码 kb_admin.py 与
# build/kb_admin.spec 入库；exe 与 PyInstaller 工作目录不入库）
kb_admin.exe
build/pyi_kbadmin/
# gh-pages 发布暂存（组件 7z + sha1 + Updates.xml，单次 200MB 级）
build/ghpages_push/

# 字幕校准工作目录（片源、cues/calib TSV、对照等中间产物，本机留档不入库；
# 以后新增工作目录照此追加一行）
_calib_*/
denia_voice_calib/
laterano_calib/

# 根目录的字幕交付件（如「【字幕】xxx-谷歌翻译-校准.srt」，成品另存不入库）
【字幕】*

# OS
.DS_Store
Thumbs.db
