/* vt_fluent 公共结构规则（明暗两档一致的部分）。
 *
 * 载入顺序：common.qss + (light.qss | dark.qss) 合并后经 renderQss()
 * 替换 --ThemeColorXxx / --FontFamilies 占位符，再 setStyleSheet 到控件。
 * 规则按 Qt 类名作用域：套到任一控件上，只有与其类名匹配的规则生效，
 * 故「全量合并」与「逐控件分文件」渲染等价（见 _theme.py FluentStyleSheet）。
 *
 * 逐值基准：qfluentwidgets 1.11.3 对应 QSS（data/tmp/qss_ref/qss/，
 * 跑 scripts/dev/_gen_vt_fluent_icons.py 再生）。B0 交付标签/提示底座，
 * B1 补按钮/输入/展示族结构，B2/B3 续补。
 *
 * 注：RadioButton/Slider 的指示器 QSS 与 CheckBox::indicator 在 Fluent 类
 * 上是**惰性规则**（这些类的 paintEvent 全自绘，不走样式子控件绘制）——
 * 保留是为 style 几何契约与潜在的原生 QRadioButton/QSlider 实例对齐。
 */

/* ---- 标签基类（B0） -------------------------------------------------- */
/* ⚠ 不设 font：字号/字重由各标签类 Python 侧 getFont() 给出
   （Caption 12 / Body 14 / Strong 14 半粗 / Subtitle 20 / Title 28）。
   QSS 类型选择器匹配子类，写死 font 会把全部标签盖成同一号。 */
FluentLabelBase {
    background-color: transparent;
    border: none;
}

/* ---- 工具提示（B0） -------------------------------------------------- */
ToolTip {
    border-radius: 4px;
}

/* ---- 超链接标签结构（颜色在明暗文件） -------------------------------- */
HyperlinkLabel {
    border: none;
    background-color: transparent;
    text-align: left;
    padding: 0;
    margin: 0;
}

/* ---- 按钮族结构 ------------------------------------------------------ */
PushButton, ToolButton, ToggleButton, ToggleToolButton {
    border-radius: 5px;
    padding: 5px 12px 6px 12px;
    outline: none;
}

ToolButton {
    padding: 5px 9px 6px 8px;
}

PushButton[hasIcon=false] {
    padding: 5px 12px 6px 12px;
}

PushButton[hasIcon=true] {
    padding: 5px 12px 6px 36px;
}

DropDownToolButton,
PrimaryDropDownToolButton {
    padding: 5px 31px 6px 8px;
}

DropDownPushButton[hasIcon=false],
PrimaryDropDownPushButton[hasIcon=false] {
    padding: 5px 31px 6px 12px;
}

DropDownPushButton[hasIcon=true],
PrimaryDropDownPushButton[hasIcon=true] {
    padding: 5px 31px 6px 36px;
}

HyperlinkButton[hasIcon=false] {
    padding: 5px 12px 6px 12px;
}

HyperlinkButton[hasIcon=true] {
    padding: 5px 12px 6px 36px;
}

RadioButton {
    min-height: 24px;
    max-height: 24px;
    background-color: transparent;
    font: 14px --FontFamilies;
    outline: none;
}

RadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    margin-right: 4px;
}

/* ---- 复选结构（自绘指示器；文字色在明暗文件） ------------------------ */
CheckBox {
    spacing: 8px;
    min-width: 28px;
    min-height: 22px;
    outline: none;
    margin-left: 1px;
}

CheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid transparent;
    background-color: transparent;
}

/* ---- 输入框结构 ------------------------------------------------------ */
LineEdit, TextEdit, PlainTextEdit, TextBrowser {
    border-radius: 5px;
    padding: 0px 10px;
    outline: none;
}

TextEdit, PlainTextEdit, TextBrowser {
    padding: 2px 3px 2px 8px;
}

LineEditButton {
    background-color: transparent;
    border-radius: 4px;
    margin: 0;
}

/* ---- 数字框结构 ------------------------------------------------------ */
SpinBox, DoubleSpinBox {
    border-radius: 5px;
    padding: 0px 80px 0 10px;
}

CompactSpinBox, CompactDoubleSpinBox {
    padding: 0px 26px 0 10px;
}

SpinBox:read-only, DoubleSpinBox:read-only,
SpinBox[symbolVisible=false], DoubleSpinBox[symbolVisible=false],
CompactSpinBox:read-only, CompactDoubleSpinBox:read-only,
CompactSpinBox[symbolVisible=false], CompactDoubleSpinBox[symbolVisible=false] {
    padding: 0px 10px 0 10px;
}

/* ---- 下拉框结构 ------------------------------------------------------ */
ComboBox, QFontComboBox {
    border-radius: 5px;
    padding: 5px 31px 6px 11px;
    text-align: left;
    outline: none;
}

/* ---- 开关结构 -------------------------------------------------------- */
SwitchButton {
    qproperty-spacing: 12;
    background-color: transparent;
}

SwitchButton>QLabel {
    font: 14px --FontFamilies;
    background-color: transparent;
    border: none;
}

/* ---- Pivot / 分段控件结构 -------------------------------------------- */
PivotItem {
    padding: 10px 12px;
    background-color: transparent;
    border: none;
    outline: none;
}

PivotItem[hasIcon=false] {
    padding-left: 12px;
    padding-right: 12px;
}

PivotItem[hasIcon=true] {
    padding-left: 36px;
    padding-right: 12px;
}

Pivot {
    border: none;
    background-color: transparent;
}

SegmentedToolItem {
    padding: 5px 9px 6px 8px;
}

SegmentedWidget, SegmentedToolWidget {
    border-radius: 6px;
}

SegmentedItem[isSelected=false], SegmentedToolItem[isSelected=false] {
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    margin: 3px 0px;
}

SegmentedItem[isSelected=true], SegmentedToolItem[isSelected=true] {
    padding-top: 6px;
    padding-bottom: 6px;
    margin: 0px;
    background-color: transparent;
}

/* ---- 表格 / 列表结构（行选中由 delegate 自绘） ----------------------- */
QTableView {
    background: transparent;
    outline: none;
    border: none;
    selection-background-color: transparent;
    alternate-background-color: transparent;
}

QTableView::item {
    background: transparent;
    border: 0px;
    padding-left: 16px;
    padding-right: 16px;
    height: 35px;
}

QTableView::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: none;
    background-color: transparent;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: transparent;
    padding-left: 5px;
    padding-right: 5px;
    font: 13px --FontFamilies;
}

QHeaderView::section:horizontal {
    border-left: none;
    height: 33px;
}

QHeaderView::section:vertical {
    border-top: none;
}

QHeaderView::section:checked {
    background-color: transparent;
}

ListView, ListWidget {
    background: transparent;
    outline: none;
    border: none;
    selection-background-color: transparent;
    alternate-background-color: transparent;
    padding-left: 4px;
    padding-right: 4px;
}

ListView::item, ListWidget::item {
    background: transparent;
    border: 0px;
    padding-left: 11px;
    padding-right: 11px;
    height: 35px;
}

ListView::indicator, ListWidget::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: none;
    background-color: transparent;
    margin-right: 4px;
}

/* ---- 菜单（B2） ------------------------------------------------------ */
RoundMenu {
    background-color: transparent;
    border: none;
}

MenuActionListWidget {
    border-radius: 9px;
    outline: none;
    font: 14px --FontFamilies;
}

MenuActionListWidget::item {
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    margin-left: 6px;
    margin-right: 6px;
    border: none;
}

#commandListWidget[dropDown=true][long=false] {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

#commandListWidget[dropDown=true][long=true] {
    border-top-left-radius: 9px;
    border-top-right-radius: 0px;
}

#commandListWidget[dropDown=false][long=true] {
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 0px;
}

#commandListWidget[dropDown=false][long=false] {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#completerListWidget::item,
#comboListWidget::item {
    margin-top: 4px;
}

#checkableListWidget::item {
    padding-left: 36px;
}

/* ======================================================================
 * 扩展域（QSS 库完整化）：滚动条 / 进度条 / Tab / 分隔器 / 滚动区基座
 *
 * 颜色一律走 --Token 占位符，值在 _theme.DESIGN_TOKENS（明暗单点登记）。
 * 覆盖面按项目真实控件划定：QListWidget/QTreeWidget 原生规则**刻意不写**
 * （宿主零实例；且类型选择器会连带匹配自研 ListWidget 子类，与既有
 * `ListView/ListWidget` 规则产生同特异性顺序竞争，引入覆盖风险）。
 * ====================================================================== */

/* ---- 滚动条（SmoothScrollBar 与原生 QScrollBar 实例共用） ------------ */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
    outline: none;
}

QScrollBar::handle:vertical {
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
    outline: none;
}

QScrollBar::handle:horizontal {
    border-radius: 3px;
    min-width: 30px;
}

/* Fluent 滚动条无箭头按钮：行按钮与翻页底全部隐藏 */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- 进度条（原生 QProgressBar 实例；自研 ProgressBar 全自绘为惰性） -- */
QProgressBar {
    border: none;
    border-radius: 4px;
    text-align: center;
    outline: none;
}

QProgressBar::chunk {
    border-radius: 4px;
    background-color: --ThemeColorPrimary;
}

/* ⚠️ 已移除自编的 Tab 规则（QTabWidget::pane / QTabBar / QTabBar::tab）：
   上游 tab_view.qss 只对 Fluent 的 `TabBar` 类生效，自编的 `QTabBar`
   选择器会改变宿主**原生 QTabWidget** 的外观，与上游行为不符。 */

/* ---- 分隔器（QSplitter 手柄） ----------------------------------------- */
QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle {
    background-color: --SplitterFill;
    border: none;
    border-radius: 1px;
}

/* ---- 滚动区基座（透明化：页面底色由窗口/页面容器自管） ----------------- *
 * 第二层选择器精确命中「viewport 的直接子代」= setWidget() 装入的内容
 * 控件——QScrollArea.setWidget 会把它强制 autoFillBackground=True（按
 * QPalette.Window 自填充浅色底，即深色主题「发白」缺陷的根因），QSS
 * 规则可压过 palette 填充，使容器层透明、内容卡片自管底色。 */
QScrollArea {
    background: transparent;
    border: none;
}

/* ⚠️ 已移除 `QScrollArea > QWidget > QWidget { background: transparent; }`：
   实测该第二层选择器会连带清掉「滚动区内容容器」（含设置页卡片组）的底色，
   是深色主题「发白」的候选元凶之一。现只透明化 QScrollArea 自身，
   底色交由窗口 / StackedWidget 承担（见文件末的窗口级规则）。 */

/* ---- 窗口 / 内容容器结构（照抄上游 fluent_window.qss） ---------------- */
StackedWidget {
    border-right: none;
    border-bottom: none;
    border-top-left-radius: 10px;
}

StackedWidget[isTransparent=true] {
    border: none;
}

NavigationInterface {
    background-color: transparent;
}

FluentTitleBar {
    background-color: transparent;
}
